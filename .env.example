# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública do app (usada nos links de convite e no e-mail de login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cobrança manual da assinatura (Pix do Thiago) e WhatsApp para o comprovante (só números, com 55 e DDD)
NEXT_PUBLIC_BILLING_PIX_KEY=
NEXT_PUBLIC_BILLING_WHATSAPP=5511999999999

# Notificações push (opcional: sem estas variáveis os avisos ficam desligados)
# Gere as chaves uma vez com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Chave secreta do Supabase (Project Settings > API Keys > Secret keys). Só no servidor!
SUPABASE_SECRET_KEY=
# Senha da rotina diária de avisos (qualquer texto longo e aleatório); a Vercel manda sozinha.
CRON_SECRET=
# A mesma SUPABASE_SECRET_KEY também liga o link de acesso do jogador (/entrar/...).

# Mostra o botão "Entrar com Google" (depois de ativar o Google em Authentication > Providers)
NEXT_PUBLIC_GOOGLE_LOGIN=0
